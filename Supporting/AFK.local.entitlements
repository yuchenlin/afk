<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local builds without a provisioning profile: iCloud key-value storage is a
	     restricted entitlement, and macOS refuses to launch an app that claims it
	     without a matching embedded profile (AMFI "No matching profile found"). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
